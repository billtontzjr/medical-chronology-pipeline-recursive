# Anthropic API key for Claude calls (extraction, assembly, header fallback, summary)
ANTHROPIC_API_KEY=

# Google Vision OCR
GOOGLE_VISION_API_KEY=

# Dropbox OAuth (used for input download and output upload)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Optional: override the default Claude model for both extraction and assembly.
# Default: claude-sonnet-4-6. Use claude-opus-4-7 for higher accuracy at higher cost.
ANTHROPIC_MODEL=claude-sonnet-4-6
